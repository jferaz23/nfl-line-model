!artifacts/margin_coefficients.csv
!artifacts/total_coefficients.csv
artifacts/forecasts/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# live scoreboard is rebuilt every line-watch run and deployed, not committed
site_data/live.json

# local tool settings
.claude/
